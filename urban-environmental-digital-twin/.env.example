# ---------------------------------------------------------------------------
# Environment variable template for the Urban Environmental Digital Twin.
# Copy this file to `.env` and fill in real values locally.
# Do NOT commit the real `.env` file or any real secrets.
# ---------------------------------------------------------------------------

# Full SQLAlchemy/PostgreSQL connection string
# For Supabase (Project Settings -> Database -> Connection string -> URI):
# Mode (Session / Port 5432): postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Or Direct: postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# PostgreSQL connection components (used if DATABASE_URL is not provided)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# Supabase API Settings (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAQ API v3 Key (required for dataset acquisition)
OPENAQ_API_KEY=

# AI / LLM integration (to be added in a later phase)
LLM_API_KEY=
