# ---------------------------------------------------------------------------
# Environment variable template for the Urban Environmental Digital Twin.
# Copy this file to `.env` and fill in real values locally.
# Do NOT commit the real `.env` file or any real secrets.
# ---------------------------------------------------------------------------

# Full SQLAlchemy/PostgreSQL connection string
# Example format (fill in locally):
# postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# PostgreSQL connection components
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# OpenAQ API v3 Key (required for dataset acquisition)
OPENAQ_API_KEY=

# AI / LLM integration (to be added in a later phase)
LLM_API_KEY=
